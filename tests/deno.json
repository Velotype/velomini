{
    "tasks": {
        "bundle-event-triggers": "deno bundle ./test_modules/event-triggers.tsx --output ./build/event-triggers.js --sourcemap=linked",
        "bundle-return-types": "deno bundle ./test_modules/return-types.tsx --output ./build/return-types.js --sourcemap=linked",
        "bundle-attrs-types": "deno bundle ./test_modules/attrs-types.tsx --output ./build/attrs-types.js --sourcemap=linked",
        "bundle-basic-div": "deno bundle ./test_modules/basic-div.tsx --output ./build/basic-div.js --sourcemap=linked"
    },
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "@velotype/velomini",
        "lib": [
            "dom",
            "esnext"
        ]
    },
    "imports": {
        "@velotype/veloserver": "jsr:@velotype/veloserver@^0.0.2",
        "@velotype/velomini/jsx-runtime": "../src/jsx-runtime/jsx-runtime.ts",
        "@velotype/velomini": "../src/jsx-runtime/jsx-runtime.ts"
    },
    "lint": {
        "rules": {
            "exclude": [
                "jsx-key"
            ]
        }
    }
}
